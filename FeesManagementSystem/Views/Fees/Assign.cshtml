@{
    ViewData["Title"] = "Assign Fee";
}

<h1>Assign Fee</h1>

<h4>Fee Assignment</h4>
<hr />
<div class="row">
    <div class="col-md-10">
        <form asp-action="Assign">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label class="control-label">Registration No</label>
                    <input type="text" id="registrationNoInput" class="form-control" />
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label class="control-label">Student</label>
                    <input type="text" id="studentNameInput" class="form-control" readonly />
                    <input type="hidden" name="studentId" id="studentIdInput" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 form-group mb-3">
                    <label class="control-label">Fee Head</label>
                    <select name="feeHeadId" class="form-control" asp-items="ViewBag.FeeHeadId">
                       <option value="">Select Fee Head</option>
                    </select>
                </div>
                <div class="col-md-4 form-group mb-3">
                    <label class="control-label">Amount</label>
                    <input name="amount" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4 form-group mb-3">
                    <label class="control-label">Due Date</label>
                    <input name="dueDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="Assign" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        var studentLookup = @Html.Raw(ViewBag.StudentLookup);

        $(document).ready(function() {
            $('#registrationNoInput').on('input', function() {
                var inputRegNo = $(this).val().trim();
                var foundStudent = studentLookup.find(function(s) {
                    return s.RegistrationNo && s.RegistrationNo.toLowerCase() === inputRegNo.toLowerCase();
                });
                
                if (foundStudent) {
                    $('#studentIdInput').val(foundStudent.Id);
                    $('#studentNameInput').val(foundStudent.Name);
                } else {
                    $('#studentIdInput').val('');
                    $('#studentNameInput').val('');
                }
            });
        });
    </script>
}
