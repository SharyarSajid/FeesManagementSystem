@model FeesManagementSystem.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Create New Password";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="login-split-screen">
    <div class="login-image-side">
        <div class="login-image-overlay"></div>
        <div class="login-text-overlay">
            <h1>Create New Password</h1>
            <p>Your new password must be unique from those previously used.</p>
        </div>
    </div>
    <div class="login-form-side">
        <div class="login-card">
            <div class="login-header">
                <h2>Reset Password</h2>
                <p>Enter your new password below.</p>
            </div>
            <form asp-action="ResetPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                
                <div class="form-group mb-4">
                    <label asp-for="NewPassword" class="control-label">New Password</label>
                    <div class="password-wrapper">
                        <input asp-for="NewPassword" class="form-control form-control-premium" id="newPasswordField" placeholder="New Password" oncopy="return false" oncut="return false" onpaste="return false"/>
                        <button type="button" class="input-group-text-premium" onclick="togglePasswordVisibility('newPasswordField', 'newPasswordIcon')">
                            <i class="bi bi-eye" id="newPasswordIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="ConfirmPassword" class="control-label">Confirm Password</label>
                    <div class="password-wrapper">
                        <input asp-for="ConfirmPassword" class="form-control form-control-premium" id="confirmPasswordField" placeholder="Confirm Password" oncopy="return false" oncut="return false" onpaste="return false" />
                        <button type="button" class="input-group-text-premium" onclick="togglePasswordVisibility('confirmPasswordField', 'confirmPasswordIcon')">
                            <i class="bi bi-eye" id="confirmPasswordIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-premium">Reset Password</button>
                </div>
            </form>

             <div class="auth-links">
                <p><a asp-action="Login" asp-controller="Account">Back to Login</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function togglePasswordVisibility(fieldId, iconId) {
            const field = document.getElementById(fieldId);
            const icon = document.getElementById(iconId);
            
            if (field.type === "password") {
                field.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                field.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}
