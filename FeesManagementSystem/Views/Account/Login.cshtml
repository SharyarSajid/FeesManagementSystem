@model FeesManagementSystem.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="login-split-screen">
    <div class="login-image-side">
        <div class="login-image-overlay"></div>
        <div class="login-text-overlay">
            <h1>Welcome Back!</h1>
            <p>Empowering education through efficient management.</p>
        </div>
    </div>
    <div class="login-form-side">
        <div class="login-card">
            <div class="login-header">
                <h2>Login</h2>
                <p>Please enter your details to login.</p>
            </div>
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="form-group mb-4">
                    <label asp-for="Email" class="control-label">Email Address</label>
                    <input asp-for="Email" class="form-control form-control-premium" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-4">
                    <label asp-for="Password" class="control-label">Password</label>
                    <div class="password-wrapper">
                        <input asp-for="Password" class="form-control form-control-premium" id="passwordField" placeholder="Enter your password" oncopy="return false" oncut="return false" onpaste="return false" />
                        <button type="button" class="input-group-text-premium" onclick="togglePasswordVisibility('passwordField', 'passwordIcon')">
                            <i class="bi bi-eye" id="passwordIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-premium">Login</button>
                </div>
            </form>

            <div class="auth-links">
                <p>Don't have an account? <a asp-action="CreateAccount" asp-controller="Account">Create Account</a></p>
                <p class="mt-2"><a asp-action="ForgotPassword" asp-controller="Account">Forgot Password?</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function togglePasswordVisibility(fieldId, iconId) {
            const field = document.getElementById(fieldId);
            const icon = document.getElementById(iconId);
            
            if (field.type === "password") {
                field.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                field.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}
