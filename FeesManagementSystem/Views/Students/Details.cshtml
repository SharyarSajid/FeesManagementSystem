@model FeesManagementSystem.Models.Student

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Student</h4>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.RegistrationNo)</dt>
                <dd class = "col-sm-8">@Html.DisplayFor(model => model.RegistrationNo)</dd>
                
                <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.Name)</dt>
                <dd class = "col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.FatherName)</dt>
                <dd class = "col-sm-8">@Html.DisplayFor(model => model.FatherName)</dd>

                <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.DateOfBirth)</dt>
                <dd class = "col-sm-8">@Html.DisplayFor(model => model.DateOfBirth)</dd>

                <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.MobileNo)</dt>
                <dd class = "col-sm-8">@Html.DisplayFor(model => model.MobileNo)</dd>
                
                <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.Email)</dt>
                <dd class = "col-sm-8">@Html.DisplayFor(model => model.Email)</dd>
                
                <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.Gender)</dt>
                <dd class = "col-sm-8">@Html.DisplayFor(model => model.Gender)</dd>
            </dl>
        </div>
        <div class="col-md-6">
             <dl class="row">
                <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.Department)</dt>
                <dd class = "col-sm-8">@Html.DisplayFor(model => model.Department)</dd>

                <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.Course)</dt>
                <dd class = "col-sm-8">@Html.DisplayFor(model => model.Course)</dd>

                <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.City)</dt>
                <dd class = "col-sm-8">@Html.DisplayFor(model => model.City)</dd>

                <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.Address)</dt>
                <dd class = "col-sm-8">@Html.DisplayFor(model => model.Address)</dd>

                <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.AdmissionDate)</dt>
                <dd class = "col-sm-8">@Html.DisplayFor(model => model.AdmissionDate)</dd>

                <dt class = "col-sm-4">Photo</dt>
                <dd class = "col-sm-8">
                    @if (!string.IsNullOrEmpty(Model.PhotoPath))
                    {
                        <img src="~/images/@Model.PhotoPath" alt="Student Photo" width="150" />
                    }
                    else
                    {
                        <span>No Photo</span>
                    }
                </dd>
            </dl>
        </div>
    </div>
</div>

<h3>Fee History</h3>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Fee Head</th>
            <th>Amount</th>
            <th>Due Date</th>
            <th>Status</th>
            <th>Paid Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var fee in (IEnumerable<FeesManagementSystem.Models.StudentFee>)ViewBag.Fees)
        {
            <tr class="@(fee.IsPaid ? "table-success" : (fee.DueDate < DateTime.Today ? "table-danger" : ""))">
                <td>@fee.FeeHead?.Name</td>
                <td>@fee.Amount.ToString("C")</td>
                <td>@fee.DueDate.ToShortDateString()</td>
                <td>
                    @if(fee.IsPaid) { <span class="badge bg-success">Paid</span> }
                    else { <span class="badge bg-danger">Unpaid</span> }
                </td>
                <td>@fee.PaidDate?.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
