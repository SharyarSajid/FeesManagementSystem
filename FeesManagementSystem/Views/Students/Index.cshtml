@model IEnumerable<FeesManagementSystem.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-primary fw-bold"><i class="bi bi-people-fill me-2"></i>Students List</h5>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Student</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="ps-4">Photo</th>
                        <th>@Html.DisplayNameFor(model => model.RegistrationNo)</th>
                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.Department)</th>
                        <th>@Html.DisplayNameFor(model => model.MobileNo)</th>
                        <th>@Html.DisplayNameFor(model => model.Email)</th>
                        @if (User.IsInRole("Supervisor"))
                        {
                        <th class="text-end pe-4">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
            @foreach (var item in Model) {
                    <tr>
                        <td class="ps-4">
                            @if (!string.IsNullOrEmpty(item.PhotoPath))
                            {
                                <img src="~/images/@item.PhotoPath" alt="Photo" width="40" height="40" class="rounded-circle border" style="object-fit:cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center border" style="width: 40px; height: 40px;">
                                    <i class="bi bi-person text-secondary"></i>
                                </div>
                            }
                        </td>
                        <td class="fw-medium">@Html.DisplayFor(modelItem => item.RegistrationNo)</td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td><span class="badge bg-light text-dark border">@Html.DisplayFor(modelItem => item.Department)</span></td>
                        <td>@Html.DisplayFor(modelItem => item.MobileNo)</td>
                        <td>@Html.DisplayFor(modelItem => item.Email)</td>
                        @if (User.IsInRole("Supervisor"))
                        {
                        <td class="text-end pe-4">
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Details"><i class="bi bi-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Delete"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                        }
                    </tr>
            }
                </tbody>
            </table>
        </div>
    </div>
</div>
